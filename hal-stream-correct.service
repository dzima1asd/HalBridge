[Unit]
Description=HAL Stream Engine FINAL (100% Working)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=hal
Group=hal
WorkingDirectory=/home/hal/HALbridge
ExecStart=/usr/bin/python3 /home/hal/HALbridge/hal_stream_final.py --auto-start
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hal-stream-final

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/hal/HALbridge/media

[Install]
WantedBy=multi-user.target
