{
  "manifest_version": 3,
  "name": "HalBridge 🧠 ChatGPT Lokalny Agent",
  "version": "1.0",
  "description": "Integracja ChatGPT z lokalnym systemem HalBridge (komendy, prompt, AI).",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HalBridge"
  }
}
